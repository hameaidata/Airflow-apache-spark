# SECRETOS - nunca subir
.env
.env.local
*.key
*.pem
*.jks
*.keytab

# Material TLS. plataforma.key es LA CLAVE PRIVADA del certificado del banco:
# quien la tenga puede suplantar las tres interfaces. No se versiona nunca.
# El .csr y el .crt no son secretos, pero se excluyen igual para que nadie
# instale por error el certificado de otro entorno.
tls/

# Unidades Quadlet GENERADAS. Contienen secretos resueltos en claro: systemd
# no expande variables en Environment=, asi que la contrasena de PostgreSQL
# acaba escrita dentro de la cadena de conexion. No se versionan y no viajan
# en el paquete: se generan EN EL SERVIDOR con
#     python3 scripts/generar_quadlet.py
rhel/quadlet/
bundle-offline/

# Los .env.windows / .env.ubuntu / .env.rhel que se entregan traen secretos
# generados. Si vas a versionarlos, reemplaza los valores por placeholders.

# Airflow
airflow/logs/
airflow/config/airflow.cfg
airflow/**/__pycache__/
*.pyc

# Spark
spark/events/
spark-warehouse/

# Datos
data/
*.csv
*.parquet

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
